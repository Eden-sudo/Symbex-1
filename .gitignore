# =============================================================================
# SYMBEX-1 -- what does NOT go to GitHub
# Rule: research and development stays in the archive. Only the library, the CDT and what a
# benchmark exposes (scripts, configs, READMEs and its result .json files) are published.
# =============================================================================

# ---- environments
.venv/
env_bench/
__pycache__/
*.pyc

# ---- research and development (kept locally, never published)
archive/
convul_symbex_v3/
symbex_x86/

# ---- datasets (downloaded or prepared by the scripts)
data/
**/data/
*.npy
*.npz

# ---- trained models and generated binaries (re-created by the scripts)
*.pth
*.pt
*.onnx
*.tflite
*.u8
**/*_binarized/
**/models/

# ---- benchmark outputs: only benchmarks/*/results/*.json are published
benchmarks/**/runs/

# ---- firmware projects generated by the CDT / benchmarks
.pio/
**/.pio/
**/chip_esp32/
**/chip_s3/
**/*_PIO/
!Symbex1_PIO/
sdkconfig
sdkconfig.old

# ---- editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
benchmarks/cnn_cifar_vgg/
benchmarks/gpu/
